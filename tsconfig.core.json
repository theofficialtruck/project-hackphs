{
  // Extra check for the game engine only. It removes the browser (DOM) and Vite
  // type definitions, so any engine code that touches `document`, `window`,
  // `localStorage`, etc. fails type checking. This keeps the engine usable from
  // any page and from Node (tests, scripts).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["src/core"],
  "exclude": ["src/core/**/*.test.ts"]
}
